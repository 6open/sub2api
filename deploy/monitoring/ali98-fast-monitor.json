{
  "feishu_config_path": "/etc/sub2api-feishu-monitor/config.json",
  "state_path": "/var/lib/sub2api-feishu-fast-monitor/state.json",
  "service_label": "ali98 / Link Label",
  "service_symbol": "[FAST]",
  "reminder_schedule_seconds": [120, 300, 600, 1200, 1800],
  "recovery_success_checks": 2,
  "checks": [
    {
      "key": "ali98_local_health",
      "label": "ali98 本机 sub2api",
      "url": "http://127.0.0.1:18080/health",
      "expected_statuses": [200],
      "timeout_seconds": 3,
      "fail_threshold": 2
    },
    {
      "key": "ali98_public_frontend",
      "label": "ali98 公网网站首页",
      "url": "https://lklb.top/",
      "resolve": "lklb.top:443:127.0.0.1",
      "insecure_skip_verify": true,
      "expected_statuses": [200],
      "expected_content": "<div id=\"app\"></div>",
      "timeout_seconds": 5,
      "fail_threshold": 2
    },
    {
      "key": "ali47_public_health",
      "label": "ali47 公网域名",
      "url": "https://migo-ai.migomigo.com/health",
      "resolve": "migo-ai.migomigo.com:443:47.99.220.197",
      "expected_statuses": [200],
      "expected_content": "\"status\":\"ok\"",
      "timeout_seconds": 5,
      "fail_threshold": 2
    },
    {
      "key": "ali98_proxy_7890",
      "label": "ali98 VLESS 代理 7890",
      "url": "https://api.openai.com/v1/models",
      "proxy": "http://127.0.0.1:7890",
      "timeout_seconds": 5,
      "fail_threshold": 2
    }
  ],
  "database_error_burst": {
    "enabled": true,
    "runtime": "podman",
    "container": "sub2api-postgres",
    "window_seconds": 60,
    "min_severe_errors": 5,
    "query_fail_threshold": 2
  },
  "database_latency_burst": {
    "enabled": true,
    "runtime": "podman",
    "container": "sub2api-postgres",
    "window_seconds": 180,
    "ttft_threshold_ms": 30000,
    "critical_ttft_ms": 45000,
    "min_slow_requests": 2
  }
}
